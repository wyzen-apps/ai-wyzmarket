@startuml routage
!theme plain
skinparam {
 defaultFontName Helvetica
 defaultFontSize 12
 partition {
 FontColor blue
 FontSize 18
 ' BackgroundColor<<Client>> #E1FFE1
 }
 note {
 BackgroundColor #ffffac
 }
