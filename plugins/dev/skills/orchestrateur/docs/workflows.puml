title Workflow mr-creation — la demande vaut push

start
:1. synchro-base\n//skill git § Push, synchronisation, merge//; <<#E8F5E9>>
if (Conflit ?) then (oui)
  :STOP : fichiers en conflit; <<#FFE0B2>>
  stop
endif
if (Aucune revue globale verte\ndans les runs de la branche ?) then (oui)
  :2. revue-globale\n//expertise:revue//; <<#E1F5FE>>
endif
:3. dod sur toute la branche;
if (DoD rouge ?) then (oui)
  :STOP : DoD rouge; <<#FFE0B2>>
  stop
endif
:4. creation-mr\n//skill git, forge.md mode creer//; <<#E8F5E9>>
:5. resume + lien MR/PR;
stop
@enduml

