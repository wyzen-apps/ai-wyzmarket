title Workflow revue — variantes locale et mr

start
if (Variante mr ?) then (oui)
  :1. recuperation-mr\n//skill git, forge.md mode recuperer//; <<#E8F5E9>>
endif
:2. gate qualite\nconstat seul;
:3. revue-code\n//revue:revue//; <<#E1F5FE>>
if (Diff sensible ou audit demandé ?) then (oui)
  :4. audit sécurité\n//expertise:audit + skill audit//; <<#E8F5E9>>
endif
:5. rapport\nconstats par sévérité;
if (Variante mr ?) then (oui)
  :STOP : publier les commentaires ?; <<#FFE0B2>>
  if (Accord ?) then (oui)
    :6. publication-revue\n//skill git, forge.md mode publier//; <<#E8F5E9>>
  endif
  stop
endif
if (Constats retenus par l'humain ?) then (non)
  stop
endif
:7. branche si sur la base\n//skill git § Branche//; <<#E8F5E9>>
repeat
  repeat
    :8. corrections — TDD\n//execution:code//; <<#E1F5FE>>
    :9. gate qualite;
  repeat while (Gate rouge ?) is (oui) not (non)
  :10. commit\n//skill git § Commit//; <<#E8F5E9>>
  :11. dod;
  backward:3. revue-code;
repeat while (DoD rouge ?) is (oui) not (non)
:12. resume;
stop
@enduml

