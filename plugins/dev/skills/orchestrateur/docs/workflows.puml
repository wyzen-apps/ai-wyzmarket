title Workflow feature — branche feat

start
:1. cadrage complet\napproches, recommandation, spec.md;
:STOP : spec approuvée; <<#FFE0B2>>
:2. analyse\n//lecture:analyse//; <<#E1F5FE>>
:3. plan\n//expertise:conception//; <<#E1F5FE>>
:STOP : plan validé; <<#FFE0B2>>
:4. branche\n//skill git § Branche// + gate de référence; <<#E8F5E9>>
partition "Pour chaque tâche du plan" {
  repeat
    :5. implementation — TDD\n//execution:code//; <<#E1F5FE>>
    if (Interface touchée ?) then (oui)
      :6. ui\n//execution:code//; <<#E1F5FE>>
    endif
    if (Métier modifié ?) then (oui)
      :7. documentation\n//skill documentation-fonctionnelle//; <<#E8F5E9>>
    endif
    repeat
      :8. gate qualite\n//gate.sh//;
      if (VERT ?) then (oui)
        :9. revue-code\n//revue:revue//; <<#E1F5FE>>
      endif
      backward:10. corrections — TDD\n//execution:code//;
    repeat while (Gate rouge ou constats ?) is (oui) not (non)
    :11. commit\n//skill git § Commit//; <<#E8F5E9>>
  repeat while (Tâche restante ?) is (oui) not (non)
}
partition "Finalisation" {
  repeat
    repeat
      :12. revue-globale\n//expertise:revue//; <<#E1F5FE>>
      backward:13. corrections, 14. gate, 15. commit;
    repeat while (Constats ?) is (oui) not (non)
    :16. changelog\n//skill documentation-fonctionnelle//; <<#E8F5E9>>
    :17. dod\ngate complet + bloc DoD;
  repeat while (DoD rouge ?) is (oui) not (non)
}
:18. resume;
stop
@enduml

