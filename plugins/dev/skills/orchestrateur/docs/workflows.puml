title Workflow refactor — comportement constant

start
:1. analyse d'impact\n//lecture:analyse//; <<#E1F5FE>>
:2. plan\n//expertise:conception//; <<#E1F5FE>>
:STOP : plan validé; <<#FFE0B2>>
:3. branche\n//skill git § Branche// + gate de référence; <<#E8F5E9>>
if (Couverture du périmètre insuffisante ?) then (oui)
  :4. caracterisation\ntests figeant l'existant\n//execution:code//; <<#E1F5FE>>
  :5. gate;
  :6. commit des tests\n//skill git § Commit//; <<#E8F5E9>>
endif
partition "Pour chaque étape du plan" {
  repeat
    :7. implementation\nvaleurs attendues inchangées\n//execution:code//; <<#E1F5FE>>
    repeat
      :8. gate qualite;
      if (VERT ?) then (oui)
        :9. revue-code\n//revue:revue//; <<#E1F5FE>>
      endif
      backward:10. corrections\n//execution:code//;
    repeat while (Gate rouge ou constats ?) is (oui) not (non)
    :11. commit\n//skill git § Commit//; <<#E8F5E9>>
  repeat while (Étape restante ?) is (oui) not (non)
}
repeat
  repeat
    :12. revue-globale\n//expertise:revue//; <<#E1F5FE>>
    backward:13. corrections, 14. gate, 15. commit;
  repeat while (Constats ?) is (oui) not (non)
  :16. dod\nTDD, doc, CHANGELOG en N/A;
repeat while (DoD rouge ?) is (oui) not (non)
:17. resume;
stop
@enduml

