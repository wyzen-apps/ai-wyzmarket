title Workflow maj-dependances — branche chore

start
:1. inventaire\noutdated + audit\n//lecture:dependances//; <<#E1F5FE>>
:2. plan court\nun lot par tâche;
:STOP : lots validés; <<#FFE0B2>>
:3. branche chore\n//skill git § Branche// + gate de référence; <<#E8F5E9>>
partition "Pour chaque lot" {
  repeat
    :4. lot\nnotes de migration, montée de version\n//execution:dependances//; <<#E1F5FE>>
    repeat
      :5. gate qualite;
      if (VERT ?) then (oui)
        :6. revue-code\n//revue:revue//; <<#E1F5FE>>
      endif
      backward:7. corrections\n//execution:code//;
    repeat while (Gate rouge ou constats ?) is (oui) not (non)
    :8. commit\n//skill git § Commit//; <<#E8F5E9>>
  repeat while (Lot restant ?) is (oui) not (non)
}
:9. changelog\n//skill documentation-fonctionnelle//; <<#E8F5E9>>
:10. dod\naudit jamais N/A;
:11. resume\nversions avant / après;
stop
@enduml

