title Workflow fix — variantes debug et hotfix

start
:1. triage\nsimple ou complexe;
if (Complexe ?) then (oui)
  :2. cadrage court;
  :STOP : cadrage validé; <<#FFE0B2>>
endif
if (Variante debug ?) then (non)
  :3. branche\n//skill git § Branche//\nfix depuis la base, hotfix depuis la production; <<#E8F5E9>>
endif
:4. reproduction\n//execution:bug//\ntest rouge (debug : script dans le run); <<#E1F5FE>>
:5. diagnostic\n//expertise:bug//\ncause racine fichier:ligne; <<#E1F5FE>>
if (Variante debug ?) then (oui)
  :6. rapport\ncause, correction proposée;
  :STOP : lancer un fix ?; <<#FFE0B2>>
  stop
endif
:7. plan court;
if (Complexe ou hotfix ?) then (oui)
  :STOP : plan validé; <<#FFE0B2>>
endif
:8. implementation — correction minimale, TDD\n//execution:code//; <<#E1F5FE>>
if (Métier modifié et pas hotfix ?) then (oui)
  :9. documentation\n//skill documentation-fonctionnelle//; <<#E8F5E9>>
endif
repeat
  repeat
    :10. gate\nqualite (hotfix : complet);
    if (VERT ?) then (oui)
      :11. revue-code\n//revue:revue//; <<#E1F5FE>>
    endif
    backward:12. corrections — TDD\n//execution:code//;
  repeat while (Gate rouge ou constats ?) is (oui) not (non)
  :13. commit\n//skill git § Commit//; <<#E8F5E9>>
  :14. changelog\n//skill documentation-fonctionnelle//; <<#E8F5E9>>
  :15. dod;
repeat while (DoD rouge ?) is (oui) not (non)
:16. resume\ncause racine, prévention\n(hotfix : rollback, report sur la base);
stop
@enduml

